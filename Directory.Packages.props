<Project>
  <PropertyGroup>
    <!-- Lets us force patched versions of vulnerable transitive dependencies. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="NuGet.Protocol" Version="8.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <!-- Transitive pin: NuGet.Protocol depends on a vulnerable 8.0.x version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
